# =============================================================================
# macssential release credentials template
#
# 사용법: 이 파일을 .env.release로 복사한 뒤 실제 값을 채우세요.
# Usage: copy this file to .env.release and fill in real values.
#     cp .env.release.example .env.release
#
# 경고: 실제 크리덴셜이 든 .env.release는 절대 커밋하지 마세요 (.gitignore에 등록됨).
# WARNING: never commit the real .env.release file (it is git-ignored).
# =============================================================================

# 코드 서명 인증서 identity (Keychain의 Developer ID Application 인증서 이름)
# Code signing certificate identity as shown in Keychain Access.
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"

# 공증(notarization)용 Apple ID 이메일
# Apple ID email used for notarization.
APPLE_ID=""

# Apple Developer 팀 ID (10자리 영숫자)
# 10-character Apple Developer Team ID.
APPLE_TEAM_ID=""

# 앱 암호 — appleid.apple.com에서 생성, notarytool 인증용
# App-specific password from appleid.apple.com, used by notarytool.
APP_SPECIFIC_PASSWORD=""

# (선택) Sparkle 업데이트 서명용 EdDSA 개인 키
# (Optional) Sparkle EdDSA private key for update signing.
SPARKLE_EDDSA_KEY=""
